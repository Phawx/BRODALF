#include <windows.h>
#include <commctrl.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "brodalf.manifest"

/* The window app's text in other languages (tools/lang.py). */
IDR_LANG_DE RCDATA "lang/de.po"
IDR_LANG_ES RCDATA "lang/es.po"

IDD_LABEL DIALOGEX 0, 0, 240, 140
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name this drive"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Give the drive a name you will recognise on its label, like ""Blue WD 4TB"".", IDC_LABEL_TEXT, 8, 8, 224, 18
    EDITTEXT IDC_LABEL_EDIT, 8, 30, 224, 14, ES_AUTOHSCROLL
    LTEXT "Where it is kept, or what is written on it (optional), like ""Box A"":", IDC_LABEL_LOC_TEXT, 8, 50, 224, 10
    EDITTEXT IDC_LABEL_LOCATION, 8, 62, 224, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Encrypt the files on this drive (needs a passphrase)", IDC_LABEL_ENCRYPT, 8, 84, 224, 12
    AUTOCHECKBOX "Also hide the names of the files and folders on it", IDC_LABEL_HIDE, 20, 98, 212, 12
    DEFPUSHBUTTON "Set up drive", IDOK, 118, 118, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 182, 118, 50, 14
END

IDD_DRIVE DIALOGEX 0, 0, 300, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Drive details"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    EDITTEXT IDC_DRIVE_INFO, 8, 8, 284, 150, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL
    LTEXT "Name:", -1, 8, 166, 284, 10
    EDITTEXT IDC_DRIVE_NAME, 8, 178, 284, 14, ES_AUTOHSCROLL
    LTEXT "Where it is kept, or what is written on it (optional):", -1, 8, 198, 284, 10
    EDITTEXT IDC_DRIVE_LOCATION, 8, 210, 284, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Mark lost or broken...", IDC_DRIVE_LOST, 8, 230, 100, 14
    DEFPUSHBUTTON "Save", IDOK, 178, 230, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 238, 230, 54, 14
END

IDD_RISK DIALOGEX 0, 0, 420, 314
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Files at risk"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_RISK_SUMMARY, 8, 8, 404, 30
    LTEXT "Keep", -1, 8, 44, 20, 10
    EDITTEXT IDC_RISK_COPIES, 30, 42, 22, 13, ES_NUMBER
    LTEXT "copies of every file, in", -1, 56, 44, 78, 10
    EDITTEXT IDC_RISK_PLACES, 136, 42, 22, 13, ES_NUMBER
    LTEXT "different places.", -1, 162, 44, 60, 10
    PUSHBUTTON "Apply", IDC_RISK_APPLY, 226, 41, 44, 14
    LTEXT "A place is what Drives... says a drive's ""Where it is kept"" is. Drives with no place set count as one place together.", -1, 8, 60, 404, 18
    LTEXT "Back up to these next (double-click a plugged-in one to start):", -1, 8, 82, 330, 10
    PUSHBUTTON "Back up to it", IDC_RISK_BACKUP, 352, 78, 60, 14
    CONTROL "", IDC_RISK_HELP, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 94, 404, 56
    LTEXT "Files short of the target, fewest copies first:", IDC_RISK_FILES_TEXT, 8, 156, 404, 10
    CONTROL "", IDC_RISK_FILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 168, 404, 120
    DEFPUSHBUTTON "Close", IDCANCEL, 362, 294, 50, 14
END

IDD_SKIP DIALOGEX 0, 0, 300, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "What to leave out"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_SKIP_TEXT, 8, 8, 284, 42
    EDITTEXT IDC_SKIP_EDIT, 8, 54, 284, 168, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Default list", IDC_SKIP_DEFAULT, 8, 230, 60, 14
    DEFPUSHBUTTON "Save and scan", IDOK, 176, 230, 64, 14
    PUSHBUTTON "Cancel", IDCANCEL, 244, 230, 48, 14
END

IDD_NEWDB DIALOGEX 0, 0, 320, 220
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New database: what to back up"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Choose the folders to back up: these are your backup roots. BRODALF keeps track of every file and folder inside each one. You can add more later. Next you choose where to keep the database file.", IDC_NEWDB_TEXT, 8, 8, 304, 34
    LISTBOX IDC_NEWDB_LIST, 8, 46, 304, 144, LBS_NOINTEGRALHEIGHT | LBS_EXTENDEDSEL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add a folder...", IDC_NEWDB_ADD, 8, 198, 64, 14
    PUSHBUTTON "Remove", IDC_NEWDB_REMOVE, 76, 198, 48, 14
    DEFPUSHBUTTON "Next...", IDOK, 212, 198, 48, 14
    PUSHBUTTON "Cancel", IDCANCEL, 264, 198, 48, 14
END

IDD_TABLE DIALOGEX 0, 0, 460, 262
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_TABLE_TEXT, 8, 8, 444, 26
    CONTROL "", IDC_TABLE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 38, 444, 196
    PUSHBUTTON "Details...", IDC_TABLE_OPEN, 8, 242, 90, 14
    DEFPUSHBUTTON "Close", IDCANCEL, 402, 242, 50, 14
END

IDD_DELETED DIALOGEX 0, 0, 480, 282
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Deleted files"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_DEL_SUMMARY, 8, 8, 464, 34
    CONTROL "", IDC_DEL_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 46, 464, 206
    PUSHBUTTON "Restore selected files...", IDC_DEL_FILES, 8, 260, 96, 14
    PUSHBUTTON "Restore their folders...", IDC_DEL_FOLDERS, 108, 260, 90, 14
    PUSHBUTTON "Keep tracking them", IDC_DEL_ACK, 202, 260, 80, 14
    PUSHBUTTON "Forget selected...", IDC_DEL_FORGET, 286, 260, 76, 14
    DEFPUSHBUTTON "Close", IDCANCEL, 422, 260, 50, 14
END

IDD_PASSPHRASE DIALOGEX 0, 0, 240, 78
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Enter the passphrase"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PASS_TEXT, 8, 8, 224, 18
    EDITTEXT IDC_PASS_EDIT, 8, 30, 224, 14, ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON "Use the recovery key", IDC_PASS_RECOVERY, 8, 56, 90, 14
    DEFPUSHBUTTON "OK", IDOK, 118, 56, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 182, 56, 50, 14
END

IDD_NEW_PASSPHRASE DIALOGEX 0, 0, 260, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set a passphrase"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PASS_TEXT, 8, 8, 244, 34
    LTEXT "Passphrase (at least 8 characters):", -1, 8, 46, 244, 10
    EDITTEXT IDC_PASS_EDIT, 8, 58, 244, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "Type it again:", -1, 8, 78, 244, 10
    EDITTEXT IDC_PASS_EDIT2, 8, 90, 244, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Also encrypt the database file (asks for the passphrase when it opens)", IDC_PASS_CATALOG, 8, 110, 244, 12
    DEFPUSHBUTTON "Set passphrase", IDOK, 128, 130, 64, 14
    PUSHBUTTON "Cancel", IDCANCEL, 198, 130, 54, 14
END

IDD_PLACE DIALOGEX 0, 0, 270, 200
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Extra place for starred files"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PLACE_TEXT, 8, 8, 254, 58
    LTEXT "Describe it, so you can tell later what it is and where it lives (at least two words), like ""Dropbox folder on the laptop"":", -1, 8, 70, 254, 18
    EDITTEXT IDC_PLACE_LABEL, 8, 90, 254, 14, ES_AUTOHSCROLL
    LTEXT "Most it may take, in GB (leave empty for no limit), so a small free account does not fill up:", IDC_PLACE_LIMIT_TEXT, 8, 110, 254, 18
    EDITTEXT IDC_PLACE_LIMIT, 8, 130, 60, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Encrypt every copy there (needs a passphrase)", IDC_PLACE_ENCRYPT, 8, 150, 254, 12
    AUTOCHECKBOX "Also hide the names of the files and folders there", IDC_PLACE_HIDE, 20, 164, 242, 12
    DEFPUSHBUTTON "Add it", IDOK, 148, 180, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 212, 180, 50, 14
END

1 VERSIONINFO
FILEVERSION 0,9,0,0
PRODUCTVERSION 0,9,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "BRODALF backup tracker"
            VALUE "ProductName", "BRODALF"
            VALUE "FileVersion", "0.9.0"
            VALUE "ProductVersion", "0.9.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
