#include <windows.h>
#include <commctrl.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "brodalf.manifest"

/* The app's icon (tools/make_icon.py draws it); the lowest ID, so Explorer shows it. */
IDI_BRODALF ICON "brodalf.ico"

/* The window app's text in other languages (tools/lang.py). */
IDR_LANG_DE RCDATA "lang/de.po"
IDR_LANG_ES RCDATA "lang/es.po"

IDD_LABEL DIALOGEX 0, 0, 240, 164
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name this drive"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Give the drive a name you will recognise on its label, like ""Blue WD 4TB"".", IDC_LABEL_TEXT, 8, 8, 224, 18
    EDITTEXT IDC_LABEL_EDIT, 8, 30, 224, 14, ES_AUTOHSCROLL
    LTEXT "Where it is kept (optional). Drives kept in the same place count as one place:", IDC_LABEL_LOC_TEXT, 8, 50, 224, 18
    COMBOBOX IDC_LABEL_LOCATION, 8, 70, 224, 80, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Encrypt the files on this drive (needs a passphrase)", IDC_LABEL_ENCRYPT, 8, 92, 224, 12
    AUTOCHECKBOX "Also hide the names of the files and folders on it", IDC_LABEL_HIDE, 20, 106, 212, 12
    LTEXT "Neither choice can be changed later for this drive.", IDC_LABEL_NOTE, 20, 121, 212, 10
    DEFPUSHBUTTON "Set up drive", IDOK, 118, 142, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 182, 142, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 460, 276
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Copies", IDC_SET_HEAD_COPIES, 8, 8, 216, 10
    LTEXT "Copies of every file to keep:", -1, 14, 24, 150, 18
    EDITTEXT IDC_SET_COPIES, 170, 22, 40, 13, ES_NUMBER
    CONTROL "", IDC_SET_COPIES_UD, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 210, 22, 10, 13
    LTEXT "Different places they must be in:", -1, 14, 44, 150, 18
    EDITTEXT IDC_SET_PLACES, 170, 42, 40, 13, ES_NUMBER
    CONTROL "", IDC_SET_PLACES_UD, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 210, 42, 10, 13
    LTEXT "Drives kept in the same place count as one place, and so do drives with no place set. Where a drive is kept is in its details (Drives...).", -1, 14, 62, 210, 26
    LTEXT "", IDC_SET_PREVIEW, 14, 90, 210, 18
    LTEXT "Checks", IDC_SET_HEAD_CHECKS, 8, 116, 216, 10
    LTEXT "A plugged-in drive offers a check of its copies:", -1, 14, 130, 210, 10
    COMBOBOX IDC_SET_CHECK_DAYS, 14, 142, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Check copies not checked lately reads:", -1, 14, 162, 210, 10
    COMBOBOX IDC_SET_VERIFY, 14, 174, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Ask again about drives", IDC_SET_UNIGNORE, 14, 196, 210, 14
    LTEXT "Backups", IDC_SET_HEAD_BACKUP, 236, 8, 216, 10
    CONTROL "One drive after another (easier on this PC)", IDC_SET_SERIAL, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 242, 22, 210, 10
    CONTROL "Several drives at once", IDC_SET_PARALLEL, "Button", BS_AUTORADIOBUTTON, 242, 34, 210, 10
    LTEXT "Faster with two or more drives, but this PC works harder while it runs, other programs may be slower, and the backup goes at the pace of the slowest drive.", -1, 254, 46, 198, 34
    CONTROL "Let other programs come first while a job runs", IDC_SET_LOWPRI, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_GROUP | WS_TABSTOP, 242, 82, 210, 18
    LTEXT "Space kept free on each drive for the database's copies:", -1, 242, 104, 210, 18
    COMBOBOX IDC_SET_RESERVE, 242, 122, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "What to leave out in every backup root...", IDC_SET_SKIP, 242, 142, 210, 14
    LTEXT "Passphrase", IDC_SET_HEAD_PASS, 236, 166, 216, 10
    LTEXT "", IDC_SET_PASS_STATE, 242, 180, 210, 18
    PUSHBUTTON "Set a passphrase...", IDC_SET_PASS, 242, 200, 140, 14
    CONTROL "Encrypt the database file", IDC_SET_ENC_CAT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 242, 218, 210, 10
    PUSHBUTTON "Forget the passphrase until it is needed", IDC_SET_LOCK, 242, 232, 210, 14
    DEFPUSHBUTTON "OK", IDOK, 348, 256, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 402, 256, 50, 14
END

IDD_LEGEND DIALOGEX 0, 0, 470, 346
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "What the file list shows"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_LEGEND_TEXT, 8, 8, 454, 20
    CONTROL "", IDC_LEGEND_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 32, 454, 288
    DEFPUSHBUTTON "Close", IDCANCEL, 412, 326, 50, 14
END

IDD_DRIVE DIALOGEX 0, 0, 400, 306
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Drive details"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Name:", IDC_DRIVE_NAME_TEXT, 8, 8, 384, 10
    EDITTEXT IDC_DRIVE_NAME, 8, 20, 384, 14, ES_AUTOHSCROLL
    LTEXT "Where it is kept (optional). Drives kept in the same place count as one place:", IDC_DRIVE_LOC_TEXT, 8, 40, 384, 10
    COMBOBOX IDC_DRIVE_LOCATION, 8, 52, 384, 80, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_DRIVE_INFO, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 74, 384, 174
    LTEXT "", IDC_DRIVE_NOTE, 8, 254, 384, 26
    PUSHBUTTON "Mark lost or broken...", IDC_DRIVE_LOST, 8, 284, 110, 14
    DEFPUSHBUTTON "Save", IDOK, 278, 284, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 338, 284, 54, 14
END

IDD_RISK DIALOGEX 0, 0, 420, 314
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Files at risk"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_RISK_SUMMARY, 8, 8, 404, 30
    LTEXT "Keep", -1, 8, 44, 34, 10
    EDITTEXT IDC_RISK_COPIES, 44, 42, 22, 13, ES_NUMBER
    LTEXT "copies of every file, in", -1, 70, 44, 88, 10
    EDITTEXT IDC_RISK_PLACES, 160, 42, 22, 13, ES_NUMBER
    LTEXT "different places.", -1, 186, 44, 64, 10
    PUSHBUTTON "Apply", IDC_RISK_APPLY, 254, 41, 50, 14
    LTEXT "A drive's place is where it is kept; Drives... sets it. Drives with no place set count as one place together.", -1, 8, 60, 404, 18
    LTEXT "The drives that would fix the most, best first:", -1, 8, 82, 284, 10
    PUSHBUTTON "Back up to it", IDC_RISK_BACKUP, 296, 78, 116, 14
    CONTROL "", IDC_RISK_HELP, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 94, 404, 56
    LTEXT "Files below your goal, fewest copies first:", IDC_RISK_FILES_TEXT, 8, 156, 404, 10
    CONTROL "", IDC_RISK_FILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 8, 168, 404, 120
    DEFPUSHBUTTON "Close", IDCANCEL, 362, 294, 50, 14
END

IDD_SKIP DIALOGEX 0, 0, 300, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "What to leave out"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_SKIP_TEXT, 8, 8, 284, 42
    EDITTEXT IDC_SKIP_EDIT, 8, 54, 284, 168, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Default list", IDC_SKIP_DEFAULT, 8, 230, 84, 14
    DEFPUSHBUTTON "Save and scan", IDOK, 156, 230, 84, 14
    PUSHBUTTON "Cancel", IDCANCEL, 244, 230, 48, 14
END

IDD_NEWDB DIALOGEX 0, 0, 320, 220
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New database: what to back up"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Choose the folders to back up: these are your backup roots. BRODALF keeps track of every file and folder inside each one. You can add more later. Next you choose where to keep the database file.", IDC_NEWDB_TEXT, 8, 8, 304, 34
    LISTBOX IDC_NEWDB_LIST, 8, 46, 304, 144, LBS_NOINTEGRALHEIGHT | LBS_EXTENDEDSEL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add a folder...", IDC_NEWDB_ADD, 8, 198, 84, 14
    PUSHBUTTON "Remove", IDC_NEWDB_REMOVE, 96, 198, 52, 14
    DEFPUSHBUTTON "Next...", IDOK, 204, 198, 56, 14
    PUSHBUTTON "Cancel", IDCANCEL, 264, 198, 48, 14
END

IDD_TABLE DIALOGEX 0, 0, 460, 262
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_TABLE_TEXT, 8, 8, 444, 26
    CONTROL "", IDC_TABLE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 38, 444, 196
    PUSHBUTTON "Details...", IDC_TABLE_OPEN, 8, 242, 124, 14
    PUSHBUTTON "", IDC_TABLE_RESTORE, 138, 242, 160, 14
    DEFPUSHBUTTON "Close", IDCANCEL, 402, 242, 50, 14
END

IDD_DELETED DIALOGEX 0, 0, 480, 282
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Deleted files"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_DEL_SUMMARY, 8, 8, 464, 34
    CONTROL "", IDC_DEL_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 46, 464, 206
    PUSHBUTTON "Restore selected files...", IDC_DEL_FILES, 8, 260, 102, 14
    PUSHBUTTON "Restore their folders...", IDC_DEL_FOLDERS, 114, 260, 98, 14
    PUSHBUTTON "Keep tracking them", IDC_DEL_ACK, 216, 260, 90, 14
    PUSHBUTTON "Forget selected...", IDC_DEL_FORGET, 310, 260, 92, 14
    DEFPUSHBUTTON "Close", IDCANCEL, 422, 260, 50, 14
END

IDD_PASSPHRASE DIALOGEX 0, 0, 260, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Enter the passphrase"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PASS_TEXT, 8, 8, 244, 26
    EDITTEXT IDC_PASS_EDIT, 8, 38, 190, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Show", IDC_PASS_SHOW, 204, 39, 48, 12
    LTEXT "", IDC_PASS_ERROR, 8, 55, 244, 10, SS_NOPREFIX
    PUSHBUTTON "Use the recovery key", IDC_PASS_RECOVERY, 8, 70, 116, 14
    DEFPUSHBUTTON "OK", IDOK, 146, 70, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 202, 70, 50, 14
END

IDD_NEW_PASSPHRASE DIALOGEX 0, 0, 260, 222
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set a passphrase"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PASS_TEXT, 8, 8, 244, 34
    LTEXT "Current passphrase:", IDC_PASS_CUR_LABEL, 8, 46, 244, 10
    EDITTEXT IDC_PASS_CUR, 8, 58, 190, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "", IDC_PASS_CUR_ERROR, 8, 75, 244, 10, SS_NOPREFIX
    LTEXT "Passphrase:", IDC_PASS_NEW_LABEL, 8, 88, 244, 10
    EDITTEXT IDC_PASS_EDIT, 8, 100, 190, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Show", IDC_PASS_SHOW, 204, 101, 48, 12
    LTEXT "Type it again:", -1, 8, 120, 244, 10
    EDITTEXT IDC_PASS_EDIT2, 8, 132, 190, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "", IDC_PASS_RULE_LEN, 8, 150, 244, 10, SS_NOPREFIX
    LTEXT "", IDC_PASS_RULE_SAME, 8, 161, 244, 10, SS_NOPREFIX
    AUTOCHECKBOX "Also encrypt the database file (asks for the passphrase when it opens)", IDC_PASS_CATALOG, 8, 176, 244, 20, BS_MULTILINE
    PUSHBUTTON "Use the recovery key", IDC_PASS_RECOVERY, 8, 202, 114, 14
    DEFPUSHBUTTON "Set passphrase", IDOK, 128, 202, 64, 14
    PUSHBUTTON "Cancel", IDCANCEL, 198, 202, 54, 14
END

IDD_PLACE DIALOGEX 0, 0, 270, 200
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Extra place for starred files"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PLACE_TEXT, 8, 8, 254, 58
    LTEXT "Describe it, so you can tell later what it is and where it lives (at least two words), like ""Dropbox folder on the laptop"":", IDC_PLACE_LABEL_TEXT, 8, 70, 254, 18
    EDITTEXT IDC_PLACE_LABEL, 8, 90, 254, 14, ES_AUTOHSCROLL
    LTEXT "Most it may take, so a small free account does not fill up (leave empty for no limit):", IDC_PLACE_LIMIT_TEXT, 8, 110, 254, 18
    EDITTEXT IDC_PLACE_LIMIT, 8, 130, 60, 14, ES_AUTOHSCROLL
    LTEXT "GB", IDC_PLACE_GB, 72, 133, 40, 10
    AUTOCHECKBOX "Encrypt every copy there (needs a passphrase)", IDC_PLACE_ENCRYPT, 8, 150, 254, 12
    AUTOCHECKBOX "Also hide the names of the files and folders there", IDC_PLACE_HIDE, 20, 164, 242, 12
    DEFPUSHBUTTON "Add it", IDOK, 148, 180, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 212, 180, 50, 14
END

1 VERSIONINFO
FILEVERSION 0,10,2,0
PRODUCTVERSION 0,10,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "BRODALF backup tracker"
            VALUE "ProductName", "BRODALF"
            VALUE "FileVersion", "0.10.2"
            VALUE "ProductVersion", "0.10.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
