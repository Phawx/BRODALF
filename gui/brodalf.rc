#include <windows.h>
#include <commctrl.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "brodalf.manifest"

IDD_LABEL DIALOGEX 0, 0, 240, 126
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name this drive"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Give the drive a name you will recognise on its label, like ""Blue WD 4TB"".", IDC_LABEL_TEXT, 8, 8, 224, 18
    EDITTEXT IDC_LABEL_EDIT, 8, 30, 224, 14, ES_AUTOHSCROLL
    LTEXT "Where it is kept, or what is written on it (optional), like ""Box A"":", IDC_LABEL_LOC_TEXT, 8, 50, 224, 10
    EDITTEXT IDC_LABEL_LOCATION, 8, 62, 224, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Encrypt the files on this drive (needs a passphrase)", IDC_LABEL_ENCRYPT, 8, 84, 224, 12
    DEFPUSHBUTTON "Set up drive", IDOK, 118, 104, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 182, 104, 50, 14
END

IDD_DRIVE DIALOGEX 0, 0, 300, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Drive details"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    EDITTEXT IDC_DRIVE_INFO, 8, 8, 284, 150, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL
    LTEXT "Name:", -1, 8, 166, 284, 10
    EDITTEXT IDC_DRIVE_NAME, 8, 178, 284, 14, ES_AUTOHSCROLL
    LTEXT "Where it is kept, or what is written on it (optional):", -1, 8, 198, 284, 10
    EDITTEXT IDC_DRIVE_LOCATION, 8, 210, 284, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 178, 230, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 238, 230, 54, 14
END

IDD_RISK DIALOGEX 0, 0, 420, 304
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Files at risk"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_RISK_SUMMARY, 8, 8, 404, 20
    LTEXT "Keep", -1, 8, 34, 20, 10
    EDITTEXT IDC_RISK_COPIES, 30, 32, 22, 13, ES_NUMBER
    LTEXT "copies of every file, in", -1, 56, 34, 78, 10
    EDITTEXT IDC_RISK_PLACES, 136, 32, 22, 13, ES_NUMBER
    LTEXT "different places.", -1, 162, 34, 60, 10
    PUSHBUTTON "Apply", IDC_RISK_APPLY, 226, 31, 44, 14
    LTEXT "A place is what Drives... says a drive's ""Where it is kept"" is. Drives with no place set count as one place together.", -1, 8, 50, 404, 18
    LTEXT "Back up to these next (double-click a plugged-in one to start):", -1, 8, 72, 330, 10
    PUSHBUTTON "Back up to it", IDC_RISK_BACKUP, 352, 68, 60, 14
    CONTROL "", IDC_RISK_HELP, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 84, 404, 56
    LTEXT "Files short of the target, fewest copies first:", IDC_RISK_FILES_TEXT, 8, 146, 404, 10
    CONTROL "", IDC_RISK_FILES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 158, 404, 120
    DEFPUSHBUTTON "Close", IDCANCEL, 362, 284, 50, 14
END

IDD_SKIP DIALOGEX 0, 0, 300, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "What to leave out"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Scans leave out files and folders that match these, one per line. * matches anything, ? one character. End a line with / for folders only (and everything in them). A line with / in the middle, like Photos/Exports/, is a path inside a protected folder. Lines starting with # are notes.", -1, 8, 8, 284, 42
    EDITTEXT IDC_SKIP_EDIT, 8, 54, 284, 168, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Default list", IDC_SKIP_DEFAULT, 8, 230, 60, 14
    DEFPUSHBUTTON "Save and scan", IDOK, 176, 230, 64, 14
    PUSHBUTTON "Cancel", IDCANCEL, 244, 230, 48, 14
END

IDD_GUARD DIALOGEX 0, 0, 340, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Backups are paused"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    EDITTEXT IDC_GUARD_TEXT, 8, 8, 324, 110, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    PUSHBUTTON "Restore them as they were...", IDC_GUARD_RESTORE, 8, 128, 116, 14
    PUSHBUTTON "The changes are mine", IDC_GUARD_MINE, 130, 128, 96, 14
    DEFPUSHBUTTON "Decide later", IDCANCEL, 272, 128, 60, 14
END

IDD_ASOF DIALOGEX 0, 0, 260, 84
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Restore as of a date"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "Bring back the selected files as they were at the end of this day. Files that have been deleted since come back too; the newest versions BRODALF had seen by then are used.", -1, 8, 8, 244, 34
    CONTROL "", IDC_ASOF_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 8, 44, 120, 14
    DEFPUSHBUTTON "Choose where...", IDOK, 128, 64, 70, 14
    PUSHBUTTON "Cancel", IDCANCEL, 202, 64, 50, 14
END

IDD_PASSPHRASE DIALOGEX 0, 0, 240, 78
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Enter the passphrase"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PASS_TEXT, 8, 8, 224, 18
    EDITTEXT IDC_PASS_EDIT, 8, 30, 224, 14, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON "OK", IDOK, 118, 56, 60, 14
    PUSHBUTTON "Cancel", IDCANCEL, 182, 56, 50, 14
END

IDD_NEW_PASSPHRASE DIALOGEX 0, 0, 260, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set a passphrase"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT "", IDC_PASS_TEXT, 8, 8, 244, 34
    LTEXT "Passphrase (at least 8 characters):", -1, 8, 46, 244, 10
    EDITTEXT IDC_PASS_EDIT, 8, 58, 244, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "Type it again:", -1, 8, 78, 244, 10
    EDITTEXT IDC_PASS_EDIT2, 8, 90, 244, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Also encrypt the catalog file (asks for the passphrase when it opens)", IDC_PASS_CATALOG, 8, 110, 244, 12
    DEFPUSHBUTTON "Set passphrase", IDOK, 128, 130, 64, 14
    PUSHBUTTON "Cancel", IDCANCEL, 198, 130, 54, 14
END

1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "BRODALF backup catalog"
            VALUE "ProductName", "BRODALF"
            VALUE "FileVersion", "0.4.0"
            VALUE "ProductVersion", "0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
