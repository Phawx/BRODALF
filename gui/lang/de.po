#, c-format
msgid " %lld online-only cloud files not copied."
msgstr " %lld nur online verfügbare Clouddateien wurden nicht kopiert."

#: gui/main.c:2372
#, c-format
msgid ""
" The drive is full: %lld file (%ls) did not fit and waits for another drive."
msgid_plural ""
" The drive is full: %lld files (%ls) did not fit and wait for another drive."
msgstr[0] ""
" Das Laufwerk ist voll: %lld Datei (%ls) passte nicht mehr und wartet auf ein anderes Laufwerk."
msgstr[1] ""
" Das Laufwerk ist voll: %lld Dateien (%ls) passten nicht mehr und warten auf ein anderes Laufwerk."

#: gui/main.c:2378
#, c-format
msgid ""
" %lld file (%ls) is 4 GB or more and cannot go on this drive, because it is FAT32. Reformat the drive as exFAT or NTFS, or back it up to another drive."
msgid_plural ""
" %lld files (%ls) are 4 GB or more and cannot go on this drive, because it is FAT32. Reformat the drive as exFAT or NTFS, or back them up to another drive."
msgstr[0] ""
" %lld Datei (%ls) ist 4 GB oder größer und passt nicht auf dieses Laufwerk, weil es FAT32 ist. Formatieren Sie das Laufwerk als exFAT oder NTFS, oder sichern Sie sie auf einem anderen Laufwerk."
msgstr[1] ""
" %lld Dateien (%ls) sind 4 GB oder größer und passen nicht auf dieses Laufwerk, weil es FAT32 ist. Formatieren Sie das Laufwerk als exFAT oder NTFS, oder sichern Sie sie auf einem anderen Laufwerk."

#: gui/main.c:2407
#, c-format
msgid ""
"Read back what was written to %ls: every copy on it had been read back already."
msgstr ""
"Zurücklesen auf %ls: Alle Kopien darauf wurden seit dem Schreiben bereits zurückgelesen."

#: gui/main.c:2409
#, c-format
msgid ""
"Read back what was written to %ls: %lld copies, %lld good, %lld damaged, %lld missing.%ls"
