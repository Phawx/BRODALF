msgstr "Laufwerk"

#: gui/main.c:766 gui/main.c:5507 gui/main.c:5509 gui/main.c:5705 ...
msgid "State"
msgstr "Status"

#: gui/main.c:766
msgid "Copies on it"
msgstr "Kopien darauf"

#: gui/main.c:767
msgid "Space"
msgstr "Speicherplatz"

#: gui/main.c:767 gui/main.c:5820
msgid "Health"
msgstr "Zustand"

#: gui/main.c:767 gui/main.c:16951
msgid "Last checked"
msgstr "Zuletzt geprüft"

#: gui/main.c:922
msgid "Ctrl"
msgstr "Strg"

#: gui/main.c:922
msgid "Shift"
msgstr "Umschalt"

#: gui/main.c:1639
msgid "BRODALF shows the new language the next time you open it."
msgstr "BRODALF zeigt die neue Sprache beim nächsten Öffnen an."

#: gui/main.c:1774 gui/main.c:6746 gui/main.c:12384 gui/main.c:13274 ...
msgid "Yes"
msgstr "Ja"

#: gui/main.c:1774 gui/main.c:6746 gui/main.c:13274 gui/main.c:13275
msgid "No"
msgstr "Nein"

#: gui/main.c:2232
#, c-format
msgid "Scanning %ls"
msgstr "Scannen: %ls"

#: gui/main.c:2233
#, c-format
msgid ""
"May be damaged: its contents changed, but its size and time did not: %ls"
msgstr ""
"Möglicherweise beschädigt: Der Inhalt hat sich geändert, Größe und Zeit aber nicht: %ls"

#: gui/main.c:2234
#, c-format
msgid "Left alone, because something else is already at %ls"
msgstr "Übersprungen, weil unter %ls schon etwas anderes liegt"

#: gui/main.c:2235
#, c-format
msgid ""
"Backup root %ls cannot be reached, so it was skipped. Nothing in it was marked deleted."
msgstr ""
"Der Quellordner %ls ist nicht erreichbar und wurde übersprungen. Nichts darin wurde als gelöscht markiert."

#: gui/main.c:2237
#, c-format
msgid "Missing on the drive: %ls"
msgstr "Fehlt auf dem Laufwerk: %ls"

#: gui/main.c:2238
#, c-format
msgid "Damaged on the drive: %ls"
msgstr "Beschädigt auf dem Laufwerk: %ls"

#: gui/main.c:2239
#, c-format
msgid "In use by another program, so it was skipped: %ls"
msgstr "Von einem anderen Programm verwendet und daher übersprungen: %ls"

#: gui/main.c:2240
#, c-format
msgid "Moved or renamed; its copies are kept: %ls"
msgstr "Verschoben oder umbenannt; die Kopien bleiben erhalten: %ls"

#: gui/main.c:2241
#, c-format
msgid "Skipped a link: %ls"
msgstr "Verknüpfung übersprungen: %ls"

#: gui/main.c:2242
#, c-format
msgid "Online only (not on this PC), so it was skipped: %ls"
msgstr "Nur online (nicht auf diesem PC), daher übersprungen: %ls"

#: gui/main.c:2243
#, c-format
msgid "Online only (not on this PC), so it was not copied: %ls"
msgstr "Nur online (nicht auf diesem PC), daher nicht kopiert: %ls"

#: gui/main.c:2244
#, c-format
msgid "Changed while it was being copied; scan again: %ls"
msgstr "Beim Kopieren geändert; scannen Sie erneut: %ls"

#: gui/main.c:2246
#, c-format
msgid ""
"Changed again while it was being copied, so another program keeps writing it: %ls"
msgstr ""
"Beim Kopieren erneut geändert, also schreibt ein anderes Programm ständig hinein: %ls"

#: gui/main.c:2248
#, c-format
msgid ""
"%ls is bigger than every backup drive you have: leave it out, or back it up to a bigger drive."
msgstr ""
"%ls ist größer als jedes Ihrer Sicherungslaufwerke: Lassen Sie die Datei aus oder sichern Sie sie auf ein größeres Laufwerk."

#: gui/main.c:2250
#, c-format
msgid ""
"The newest copy of the database on the drive (revision %ls) is damaged. The next backup puts a new one there."
msgstr ""
"Die neueste Kopie der Datenbank auf dem Laufwerk (Revision %ls) ist beschädigt. Die nächste Sicherung legt dort eine neue ab."

#: gui/main.c:2252
#, c-format
msgid ""
"Half-written files from a copy that stopped are on the drive: %ls (%ls bytes). They can be removed."
msgstr ""
"Auf dem Laufwerk liegen halb geschriebene Dateien von einem abgebrochenen Kopiervorgang: %ls (%ls Bytes). Sie können entfernt werden."

#: gui/main.c:2253
#, c-format
msgid "A link was not followed, so %ls is not backed up: %ls"
msgstr ""
"Eine Verknüpfung wurde nicht verfolgt, daher wird %ls nicht gesichert: %ls"

#: gui/main.c:2254
#, c-format
msgid "Online only and changed in the cloud, so it is not backed up: %ls"
msgstr "Nur online und in der Cloud geändert, daher nicht gesichert: %ls"

#: gui/main.c:2256
#, c-format
msgid ""
"Backup root %ls waits for its disk to be plugged in, so it was skipped. Nothing in it was marked deleted."
msgstr ""
"Der Quellordner %ls wartet darauf, dass sein Datenträger angeschlossen wird, und wurde übersprungen. Nichts darin wurde als gelöscht markiert."

#: gui/main.c:2259
#, c-format
msgid ""
"Backup root %ls is there, but %ls of the %ls files the database knows in it are not, so it was left as it was. Nothing was marked deleted. Is it another folder with the same name?"
msgstr ""
"Der Quellordner %ls ist da, aber %ls der %ls Dateien, die die Datenbank darin kennt, fehlen, daher wurde er so gelassen, wie er war. Nichts wurde als gelöscht markiert. Ist es ein anderer Ordner mit demselben Namen?"

#: gui/main.c:2262
#, c-format
msgid ""
"Backup root %ls is now at %ls: BRODALF found its files there (%ls of the %ls it checked)."
msgstr ""
"Der Quellordner %ls ist jetzt unter %ls: BRODALF hat seine Dateien dort gefunden (%ls der %ls geprüften)."

#: gui/main.c:2265
#, c-format
msgid ""
"Backup root %ls is not where it was, and %ls folders hold its files, so BRODALF picked none: say where it is now. One is %ls (%ls of the %ls files it checked are there)."
msgstr ""
"Der Quellordner %ls ist nicht mehr dort, wo er war, und %ls Ordner enthalten seine Dateien, daher hat BRODALF keinen gewählt: Geben Sie an, wo er jetzt ist. Einer ist %ls (%ls der %ls geprüften Dateien sind dort)."

#: gui/main.c:2268
#, c-format
msgid ""
"The files of backup root %ls are in %ls (%ls of the %ls BRODALF checked). If that is where it is now, point the backup root there."
msgstr ""
"Die Dateien des Quellordners %ls sind in %ls (%ls der %ls, die BRODALF geprüft hat). Wenn er jetzt dort ist, verweisen Sie den Quellordner dorthin."

#: gui/main.c:2270
#, c-format
msgid "Gone from its folder while backing up; scan again: %ls"
msgstr ""
"Während der Sicherung aus seinem Ordner verschwunden; scannen Sie erneut: %ls"

#: gui/main.c:2271
#, c-format
msgid "An older copy is gone from the drive: %ls"
msgstr "Eine ältere Kopie fehlt auf dem Laufwerk: %ls"

#: gui/main.c:2272
#, c-format
msgid "The copy is there again as it was, so it counts again: %ls"
msgstr "Die Kopie ist wieder unverändert da und zählt wieder: %ls"

#: gui/main.c:2274
#, c-format
msgid ""
"The folder %ls has the name of BRODALF's own folder on the drives, so its new copies go to %ls instead."
msgstr ""
"Der Ordner %ls heißt wie BRODALFs eigener Ordner auf den Laufwerken, daher kommen seine neuen Kopien stattdessen nach %ls."

#: gui/main.c:2275
#, c-format
msgid "Could not read %ls, so what the database knows about it is kept."
msgstr ""
"%ls konnte nicht gelesen werden; was die Datenbank darüber weiß, bleibt erhalten."

#: gui/main.c:2276
#, c-format
msgid "Could not read %ls: %ls"
msgstr "%ls konnte nicht gelesen werden: %ls"

#: gui/main.c:2277
#, c-format
msgid "Could not read %ls"
msgstr "%ls konnte nicht gelesen werden"

#: gui/main.c:2278
#, c-format
msgid "Could not record the new version of %ls: %ls"
msgstr "Die neue Version von %ls konnte nicht vermerkt werden: %ls"

#: gui/main.c:2279
#, c-format
msgid "Could not look at %ls: %ls"
msgstr "Auf %ls konnte nicht zugegriffen werden: %ls"

#: gui/main.c:2280
#, c-format
msgid "A file BRODALF did not write is at %ls, so it is left alone."
msgstr ""
"Unter %ls liegt eine Datei, die BRODALF nicht geschrieben hat; sie bleibt unangetastet."

#: gui/main.c:2281
#, c-format
msgid "Could not find a free name on the drive for %ls: %ls"
msgstr "Für %ls wurde auf dem Laufwerk kein freier Name gefunden: %ls"

#: gui/main.c:2282
#, c-format
msgid "Could not copy %ls to the drive: %ls"
msgstr "%ls konnte nicht auf das Laufwerk kopiert werden: %ls"

#: gui/main.c:2283
#, c-format
msgid "Could not copy %ls to the drive"
msgstr "%ls konnte nicht auf das Laufwerk kopiert werden"

#: gui/main.c:2284
#, c-format
msgid "Could not write the copy of %ls to the drive"
msgstr "Die Kopie von %ls konnte nicht auf das Laufwerk geschrieben werden"

#: gui/main.c:2286
#, c-format
msgid ""
"A file appeared at %ls while it was being copied, so it was left alone. Back up again."
msgstr ""
"Während des Kopierens ist unter %ls eine Datei aufgetaucht; sie bleibt unangetastet. Sichern Sie erneut."

#: gui/main.c:2287
#, c-format
msgid "Could not finish writing %ls: %ls"
msgstr "%ls konnte nicht fertig geschrieben werden: %ls"

#: gui/main.c:2288
#, c-format
msgid "Copied %ls, but could not record it: %ls"
msgstr "%ls wurde kopiert, konnte aber nicht vermerkt werden: %ls"

#: gui/main.c:2290
#, c-format
msgid ""
"Backing up to %ls drives at once: each file is read once and written to all of them."
msgstr ""
"Sicherung auf %ls Laufwerke gleichzeitig: Jede Datei wird einmal gelesen und auf alle geschrieben."

#: gui/main.c:2291
#, c-format
msgid "Not backed up: the path stored for %ls could lead outside its folder."
msgstr ""
"Nicht gesichert: Der für %ls gespeicherte Pfad könnte aus seinem Ordner herausführen."

#: gui/main.c:2293
#, c-format
msgid ""
"%ls is FAT32 and cannot hold files of 4 GB or more; reformat it as exFAT or NTFS. Such files wait for another drive."
msgstr ""
"%ls ist mit FAT32 formatiert und kann keine Dateien ab 4 GB aufnehmen; formatieren Sie es als exFAT oder NTFS neu. Solche Dateien warten auf ein anderes Laufwerk."

#: gui/main.c:2295
msgid ""
"This drive is FAT32 and cannot hold files of 4 GB or more; reformat it as exFAT or NTFS. Such files wait for another drive."
msgstr ""
"Dieses Laufwerk ist mit FAT32 formatiert und kann keine Dateien ab 4 GB aufnehmen; formatieren Sie es als exFAT oder NTFS neu. Solche Dateien warten auf ein anderes Laufwerk."

#: gui/main.c:2296
#, c-format
msgid "%ls is full. Files that do not fit wait for another drive."
msgstr ""
"%ls ist voll. Dateien, die nicht mehr passen, warten auf ein anderes Laufwerk."

#: gui/main.c:2298
#, c-format
msgid ""
"%ls has reached the size you set for it, so starred files over it are not copied there."
msgstr ""
"%ls hat die dafür festgelegte Größe erreicht; markierte Dateien darüber hinaus werden nicht dorthin kopiert."

#: gui/main.c:2299
#, c-format
msgid "%ls stopped answering or was unplugged, so the backup stops."
msgstr ""
"%ls antwortet nicht mehr oder wurde getrennt, daher endet die Sicherung."

#: gui/main.c:2300
#, c-format
msgid "Could not record the copies found gone: %ls"
msgstr "Die verschwundenen Kopien konnten nicht vermerkt werden: %ls"

#: gui/main.c:2301
#, c-format
msgid "Could not record the copies found damaged or missing: %ls"
msgstr ""
"Die beschädigten oder fehlenden Kopien konnten nicht vermerkt werden: %ls"

#: gui/main.c:2302
#, c-format
msgid "Could not record the copies: %ls"
msgstr "Die Kopien konnten nicht vermerkt werden: %ls"

#: gui/main.c:2305
#, c-format
msgid ""
"The database could not be saved during the backup (it is saved at the end): %ls"
msgstr ""
"Die Datenbank konnte während der Sicherung nicht gespeichert werden (sie wird am Ende gespeichert): %ls"

#: gui/main.c:2306
#, c-format
msgid "The database could not be copied to the drive: %ls"
msgstr "Die Datenbank konnte nicht auf das Laufwerk kopiert werden: %ls"

#: gui/main.c:2307
#, c-format
msgid "The database could not be copied to %ls: %ls"
msgstr "Die Datenbank konnte nicht auf %ls kopiert werden: %ls"

#: gui/main.c:2309
#, c-format
msgid ""
"The copy on %ls is recorded at a path that could lead outside its folder, so it is not read: %ls"
msgstr ""
"Die Kopie auf %ls ist unter einem Pfad vermerkt, der aus ihrem Ordner herausführen könnte; sie wird nicht gelesen: %ls"

#: gui/main.c:2310
#, c-format
msgid "Restored %ls from the copy on %ls"
msgstr "%ls aus der Kopie auf %ls wiederhergestellt"

#: gui/main.c:2311
#, c-format
msgid "The copy on %ls is missing: %ls. Trying the next copy."
msgstr "Die Kopie auf %ls fehlt: %ls. Die nächste Kopie wird versucht."

#: gui/main.c:2312
#, c-format
msgid "The copy on %ls is missing: %ls"
msgstr "Die Kopie auf %ls fehlt: %ls"

#: gui/main.c:2313
#, c-format
msgid "The copy on %ls is damaged: %ls. Trying the next copy."
msgstr ""
"Die Kopie auf %ls ist beschädigt: %ls. Die nächste Kopie wird versucht."

#: gui/main.c:2314
#, c-format
msgid "The copy on %ls is damaged: %ls"
msgstr "Die Kopie auf %ls ist beschädigt: %ls"

#: gui/main.c:2315
#, c-format
msgid ""
"Could not restore %ls from the copy on %ls: %ls. Trying the next copy."
msgstr ""
"%ls konnte nicht aus der Kopie auf %ls wiederhergestellt werden: %ls. Die nächste Kopie wird versucht."

#: gui/main.c:2316
#, c-format
msgid "Could not restore %ls from the copy on %ls. Trying the next copy."
msgstr ""
"%ls konnte nicht aus der Kopie auf %ls wiederhergestellt werden. Die nächste Kopie wird versucht."

#: gui/main.c:2317
#, c-format
msgid "Could not restore %ls from the copy on %ls: %ls"
msgstr "%ls konnte nicht aus der Kopie auf %ls wiederhergestellt werden: %ls"

#: gui/main.c:2318
#, c-format
msgid "Could not restore %ls from the copy on %ls"
msgstr "%ls konnte nicht aus der Kopie auf %ls wiederhergestellt werden"

#: gui/main.c:2319
#, c-format
msgid "Out of memory: could not restore %ls"
msgstr ""
"Nicht genug Arbeitsspeicher: %ls konnte nicht wiederhergestellt werden"

#: gui/main.c:2320
#, c-format
msgid "No copy of %ls could be read back right, so it was not restored."
msgstr ""
"Keine Kopie von %ls ließ sich fehlerfrei zurücklesen, daher wurde die Datei nicht wiederhergestellt."

#: gui/main.c:2322
#, c-format
msgid ""
"Not restored: the path stored for %ls could lead outside the folder you chose."
msgstr ""
"Nicht wiederhergestellt: Der für %ls gespeicherte Pfad könnte aus dem gewählten Ordner herausführen."

#: gui/main.c:2324
#, c-format
msgid ""
"%ls: restored an older version; the newer one has no good copy to restore from."
msgstr ""
"%ls: Eine ältere Version wurde wiederhergestellt; von der neueren gibt es keine intakte Kopie."

#: gui/main.c:2325
#, c-format
msgid "%ls: restored an older version; the newer one was never backed up."
msgstr ""
"%ls: Eine ältere Version wurde wiederhergestellt; die neuere wurde nie gesichert."

#: gui/main.c:2327
#, c-format
msgid ""
"%ls: restored the version from %ls; the newer one has no good copy to restore from."
msgstr ""
"%ls: Die Version vom %ls wurde wiederhergestellt; von der neueren gibt es keine intakte Kopie."

#: gui/main.c:2328
#, c-format
msgid ""
"%ls: restored the version from %ls; the newer one was never backed up."
msgstr ""
"%ls: Die Version vom %ls wurde wiederhergestellt; die neuere wurde nie gesichert."

#: gui/main.c:2331
#, c-format
msgid "Could not change the folder %ls"
msgstr "Der Ordner %ls konnte nicht geändert werden"

#: gui/main.c:2332
#, c-format
msgid "Could not compress %ls (another program may have it open)."
msgstr ""
"%ls konnte nicht komprimiert werden (vielleicht hat ein anderes Programm die Datei geöffnet)."

#: gui/main.c:2333
#, c-format
msgid "Could not uncompress %ls (another program may have it open)."
msgstr ""
"Die Komprimierung von %ls konnte nicht aufgehoben werden (vielleicht hat ein anderes Programm die Datei geöffnet)."

#: gui/main.c:2336
#, c-format
msgid ""
"%ls is on a different disk than last time (serial %ls; it was %ls %ls)."
msgstr ""
"%ls ist auf einem anderen Datenträger als beim letzten Mal (Seriennummer %ls; vorher %ls %ls)."

#: gui/main.c:2337
#, c-format
msgid "Registered the drive %ls again"
msgstr "Das Laufwerk %ls wurde erneut registriert"

#: gui/main.c:2338
#, c-format
msgid "Could not check %ls: %ls"
msgstr "%ls konnte nicht geprüft werden: %ls"

#: gui/main.c:2340
#, c-format
msgid ""
"The backup root name %ls is not a safe folder name, so its files will not be restored."
msgstr ""
"Der Name des Quellordners %ls ist kein sicherer Ordnername; seine Dateien werden daher nicht wiederhergestellt."

#: gui/main.c:2342
#, c-format
msgid ""
"The stored path %ls could lead outside a restore folder, so it will not be restored."
msgstr ""
"Der gespeicherte Pfad %ls könnte aus einem Wiederherstellungsordner herausführen; er wird daher nicht wiederhergestellt."

#: gui/main.c:2344
#, c-format
msgid ""
"A copy on %ls is recorded at %ls, which could lead outside its folder, so it will not be read."
msgstr ""
"Eine Kopie auf %ls ist unter %ls vermerkt, was aus ihrem Ordner herausführen könnte; sie wird daher nicht gelesen."

#: gui/main.c:2346
msgid "Encrypted copies are skipped: enter the passphrase to check them too."
msgstr ""
"Verschlüsselte Kopien werden übersprungen: Geben Sie die Passphrase ein, um auch sie zu prüfen."

#: gui/main.c:2347
msgid ""
"Files changed since the scan are read again and backed up as they are now."
msgstr ""
"Dateien, die sich seit dem Scan geändert haben, werden erneut gelesen und im aktuellen Stand gesichert."

#: gui/main.c:2349
msgid ""
"Files that are online only (in the cloud, not on this PC) are skipped, not downloaded."
msgstr ""
"Dateien, die nur online sind (in der Cloud, nicht auf diesem PC), werden übersprungen, nicht heruntergeladen."

#: gui/main.c:2350
msgid "The drive is full. Files that do not fit wait for another drive."
msgstr ""
"Das Laufwerk ist voll. Dateien, die nicht mehr passen, warten auf ein anderes Laufwerk."

#: gui/main.c:2351
msgid "The drive stopped answering or was unplugged, so the backup stops."
msgstr ""
"Das Laufwerk antwortet nicht mehr oder wurde getrennt, daher endet die Sicherung."

#: gui/main.c:2353
msgid ""
"The drive stopped answering or was unplugged. Nothing on it was marked missing or damaged."
msgstr ""
"Das Laufwerk antwortet nicht mehr oder wurde getrennt. Nichts darauf wurde als fehlend oder beschädigt markiert."

#: gui/main.c:2358
#, c-format
msgid "could not look at %ls"
msgstr "auf %ls konnte nicht zugegriffen werden"

#: gui/main.c:2359
#, c-format
msgid "could not create the folder for %ls"
msgstr "der Ordner für %ls konnte nicht angelegt werden"

#: gui/main.c:2360
#, c-format
msgid "could not write %ls"
msgstr "%ls konnte nicht geschrieben werden"

#: gui/main.c:2361
#, c-format
msgid "could not move %ls to %ls"
msgstr "%ls konnte nicht nach %ls verschoben werden"

#: gui/main.c:2369
#, c-format
msgid "%ls backup root could not be found; nothing in it was marked deleted."
msgid_plural ""
"%ls backup roots could not be found; nothing in them was marked deleted."
msgstr[0] ""
"%ls Quellordner wurde nicht gefunden; nichts darin wurde als gelöscht markiert."
msgstr[1] ""
"%ls Quellordner wurden nicht gefunden; nichts darin wurde als gelöscht markiert."

#: gui/main.c:2372
#, c-format
msgid "%ls file was left alone, because something else was already there."
msgid_plural "%ls files were left alone, because something else was already there."
msgstr[0] "%ls Datei wurde übersprungen, weil dort schon etwas anderes lag."
msgstr[1] "%ls Dateien wurden übersprungen, weil dort schon etwas anderes lag."

#: gui/main.c:2374
#, c-format
msgid "Database saved; %ls file copied so far."
msgid_plural "Database saved; %ls files copied so far."
msgstr[0] "Datenbank gespeichert; bisher %ls Datei kopiert."
msgstr[1] "Datenbank gespeichert; bisher %ls Dateien kopiert."

#: gui/main.c:2376
#, c-format
msgid "Compressed: %ls file, %ls changed, %ls could not be."
msgid_plural "Compressed: %ls files, %ls changed, %ls could not be."
msgstr[0] "Komprimiert: %ls Datei, %ls geändert, bei %ls nicht möglich."
msgstr[1] "Komprimiert: %ls Dateien, %ls geändert, bei %ls nicht möglich."

#: gui/main.c:2378
#, c-format
msgid "Uncompressed: %ls file, %ls changed, %ls could not be."
msgid_plural "Uncompressed: %ls files, %ls changed, %ls could not be."
msgstr[0] ""
"Komprimierung aufgehoben: %ls Datei, %ls geändert, bei %ls nicht möglich."
msgstr[1] ""
"Komprimierung aufgehoben: %ls Dateien, %ls geändert, bei %ls nicht möglich."

#: gui/main.c:2379
#, c-format
msgid "And %ls more path like those."
msgid_plural "And %ls more paths like those."
msgstr[0] "Und %ls weiterer Pfad dieser Art."
msgstr[1] "Und %ls weitere Pfade dieser Art."

#: gui/main.c:2542
msgid ", less than a minute left"
