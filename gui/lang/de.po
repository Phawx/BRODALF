msgstr "nacheinander"

#: gui/main.c:1716
#, c-format
msgid ""
" %lld went alongside an older copy (under .versions): nothing there was overwritten."
msgstr ""
" %lld wurden neben einer älteren Kopie abgelegt (unter .versions): Dort wurde nichts überschrieben."

#: gui/main.c:1719
#, c-format
msgid " %lld copy (%ls) did not fit and waits for another drive."
msgid_plural " %lld copies (%ls) did not fit and wait for another drive."
msgstr[0] ""
" %lld Kopie (%ls) passte nicht mehr und wartet auf ein anderes Laufwerk."
msgstr[1] ""
" %lld Kopien (%ls) passten nicht mehr und warten auf ein anderes Laufwerk."

#: gui/main.c:1745
#, c-format
msgid ""
"%ls done: %lld files, %lld new, %lld changed, %lld moved or renamed, %lld deleted, %ls read."
msgstr ""
"%ls abgeschlossen: %lld Dateien, %lld neu, %lld geändert, %lld verschoben oder umbenannt, %lld gelöscht, %ls gelesen."

#: gui/main.c:1746 gui/main.c:3917
msgid "Bit-rot scan"
msgstr "Bit-Rot-Scan"

#: gui/main.c:1746 gui/main.c:3917
msgid "Scan"
msgstr "Scan"

#: gui/main.c:1748
#, c-format
msgid " %lld of the deleted files were never backed up."
msgstr " %lld der gelöschten Dateien wurden nie gesichert."

#: gui/main.c:1749
#, c-format
msgid " %lld left out by the skip lists."
msgstr " %lld wurden durch die Ausschlusslisten ausgelassen."

#: gui/main.c:1750 gui/main.c:1803
#, c-format
msgid " %lld in use by another program."
msgstr " %lld werden von einem anderen Programm verwendet."

#: gui/main.c:1751
#, c-format
msgid " %lld online-only cloud files left alone (not downloaded)."
msgstr ""
" %lld nur online verfügbare Clouddateien wurden nicht angetastet (nicht heruntergeladen)."

#: gui/main.c:1753
#, c-format
msgid ""
" %lld file changed without its size or time changing: it may be damaged."
msgid_plural ""
" %lld files changed without their size or time changing: they may be damaged."
msgstr[0] ""
" %lld Datei hat sich geändert, obwohl Größe und Änderungszeit gleich blieben: Möglicherweise ist sie beschädigt."
msgstr[1] ""
" %lld Dateien haben sich geändert, obwohl Größe und Änderungszeit gleich blieben: Möglicherweise sind sie beschädigt."

#: gui/main.c:1757
#, c-format
msgid " %lld backup root could not be found."
msgid_plural " %lld backup roots could not be found."
msgstr[0] " %lld Quellordner wurde nicht gefunden."
msgstr[1] " %lld Quellordner wurden nicht gefunden."

#: gui/main.c:1759
#, c-format
msgid " %lld stopped root left alone."
msgid_plural " %lld stopped roots left alone."
msgstr[0] " %lld nicht mehr gesicherter Quellordner wurde ausgelassen."
msgstr[1] " %lld nicht mehr gesicherte Quellordner wurden ausgelassen."

#: gui/main.c:1761
#, c-format
msgid " %lld file or folder could not be read; the log says which."
msgid_plural " %lld files or folders could not be read; the log says which."
msgstr[0] ""
" %lld Datei oder Ordner konnte nicht gelesen werden; das Protokoll nennt sie."
msgstr[1] ""
" %lld Dateien oder Ordner konnten nicht gelesen werden; das Protokoll nennt sie."

#: gui/main.c:1797
#, c-format
msgid ""
"Backup done: %lld files copied (%ls), %lld already there, %lld failed."
msgstr ""
"Sicherung abgeschlossen: %lld Dateien kopiert (%ls), %lld schon vorhanden, %lld fehlgeschlagen."

#: gui/main.c:1800
#, c-format
msgid ""
" %lld went alongside an older copy (under .versions on the drive): nothing there was overwritten."
msgstr ""
" %lld wurden neben einer älteren Kopie abgelegt (unter .versions auf dem Laufwerk): Dort wurde nichts überschrieben."

#: gui/main.c:1802
#, c-format
msgid " %lld changed since the scan and were read again first."
msgstr ""
" %lld haben sich seit dem Scan geändert und wurden zuerst neu gelesen."

#: gui/main.c:1804
#, c-format
msgid " %lld online-only cloud files not copied."
msgstr " %lld nur online verfügbare Clouddateien wurden nicht kopiert."

#: gui/main.c:1807
#, c-format
msgid ""
" The drive is full: %lld file (%ls) did not fit and waits for another drive."
msgid_plural ""
" The drive is full: %lld files (%ls) did not fit and wait for another drive."
msgstr[0] ""
" Das Laufwerk ist voll: %lld Datei (%ls) passte nicht mehr und wartet auf ein anderes Laufwerk."
msgstr[1] ""
" Das Laufwerk ist voll: %lld Dateien (%ls) passten nicht mehr und warten auf ein anderes Laufwerk."

#: gui/main.c:1826
#, c-format
msgid ""
"Read back: every copy on the drive was read back within the last %d days."
msgstr ""
"Zurücklesen: Alle Kopien auf dem Laufwerk wurden in den letzten %d Tagen bereits zurückgelesen."

#: gui/main.c:1828
#, c-format
msgid "Read back %lld copies: %lld good, %lld damaged, %lld missing.%ls"
msgstr ""
"%lld Kopien zurückgelesen: %lld intakt, %lld beschädigt, %lld fehlen.%ls"

#: gui/main.c:1830 gui/main.c:1841
msgid " The next backup to this drive writes them again."
msgstr " Die nächste Sicherung auf dieses Laufwerk schreibt sie neu."

#: gui/main.c:1831 gui/main.c:1842
#, c-format
msgid " %lld encrypted copies need the passphrase to check."
msgstr " %lld verschlüsselte Kopien brauchen zum Prüfen die Passphrase."

#: gui/main.c:1839
#, c-format
msgid ""
"Check done: %lld copies read, %lld good, %lld missing, %lld damaged.%ls"
msgstr ""
"Prüfung abgeschlossen: %lld Kopien gelesen, %lld intakt, %lld fehlen, %lld beschädigt.%ls"

#: gui/main.c:1851
msgid "Your changes are saved."
msgstr "Ihre Änderungen sind gespeichert."

#: gui/main.c:1851 gui/main.c:9063
msgid "Ready."
msgstr "Bereit."

#: gui/main.c:1860
#, c-format
msgid "Compression %ls: %lld files; their %ls now take %ls on the drive."
msgstr ""
"Komprimierung %ls: %lld Dateien; ihre %ls belegen jetzt %ls auf dem Laufwerk."

#: gui/main.c:1861
msgid "turned on"
msgstr "eingeschaltet"

#: gui/main.c:1861
msgid "turned off"
msgstr "ausgeschaltet"

#: gui/main.c:1863
#, c-format
msgid " %lld could not be changed (another program may have them open)."
msgstr ""
" %lld konnten nicht geändert werden (vielleicht hat ein anderes Programm sie geöffnet)."

#: gui/main.c:1864
msgid " Copies made from now on are compressed too."
msgstr " Ab jetzt erstellte Kopien werden ebenfalls komprimiert."

#: gui/main.c:1898
#, c-format
msgid ""
"Restore done: %lld files (%ls), %lld already there, %lld on drives that are not plugged in, %lld never backed up, %lld failed."
msgstr ""
"Wiederherstellung abgeschlossen: %lld Dateien (%ls), %lld schon vorhanden, %lld auf nicht angeschlossenen Laufwerken, %lld nie gesichert, %lld fehlgeschlagen."

#: gui/main.c:1902
#, c-format
msgid ""
" %lld left alone because another file was already there: nothing was overwritten."
msgstr ""
" %lld wurden übersprungen, weil dort schon eine andere Datei lag: Es wurde nichts überschrieben."

#: gui/main.c:1904
#, c-format
msgid " %lld need the passphrase."
msgstr " %lld brauchen die Passphrase."

#: gui/main.c:1912 gui/main.c:2220
msgid "Stopped. What was done until then is kept."
msgstr "Abgebrochen. Was bis dahin erledigt war, bleibt erhalten."

#: gui/main.c:1915
#, c-format
msgid "Stopped: %ls"
msgstr "Abgebrochen: %ls"

#: gui/main.c:1915 gui/main.c:1922
msgid "unknown error"
msgstr "unbekannter Fehler"

#: gui/main.c:1922
#, c-format
msgid "Could not save the database: %ls"
msgstr "Die Datenbank konnte nicht gespeichert werden: %ls"

#: gui/main.c:1924
msgid "Could not save the database:"
msgstr "Die Datenbank konnte nicht gespeichert werden:"

#: gui/main.c:1934 gui/main.c:2009
msgid "Updating the figures for your drives and files..."
msgstr "Die Zahlen zu Ihren Laufwerken und Dateien werden aktualisiert..."

#: gui/main.c:2003
msgid "Looking for BRODALF drives..."
msgstr "BRODALF-Laufwerke werden gesucht..."

#: gui/main.c:2003
msgid "Scanning your backup roots..."
msgstr "Ihre Quellordner werden gescannt..."

#: gui/main.c:2004
msgid "Backing up..."
msgstr "Wird gesichert..."

#: gui/main.c:2004
msgid "Checking every copy on the drive..."
msgstr "Jede Kopie auf dem Laufwerk wird geprüft..."

#: gui/main.c:2004
msgid "Restoring..."
msgstr "Wird wiederhergestellt..."

#: gui/main.c:2005
msgid "Reading back copies not read lately..."
msgstr "Länger nicht gelesene Kopien werden zurückgelesen..."

#: gui/main.c:2005
msgid "Reading files that are in use from a shadow copy..."
msgstr "Verwendete Dateien werden aus einer Schattenkopie gelesen..."

#: gui/main.c:2006
msgid "Compressing the copies on the drive..."
msgstr "Die Kopien auf dem Laufwerk werden komprimiert..."

#: gui/main.c:2006
msgid "Saving your changes and updating the figures..."
msgstr "Ihre Änderungen werden gespeichert und die Zahlen aktualisiert..."

#: gui/main.c:2007
msgid "Bit-rot scan: reading every file again..."
msgstr "Bit-Rot-Scan: Jede Datei wird erneut gelesen..."

#: gui/main.c:2008
msgid "Making the copies on the drive whole again..."
msgstr "Die Kopien auf dem Laufwerk werden dekomprimiert..."

#: gui/main.c:2048 gui/main.c:2049
msgid "Stopping..."
msgstr "Wird abgebrochen..."

#: gui/main.c:2148
#, c-format
msgid ""
"%ls\n"
"\n"
"An error report was saved to:\n"
"%ls\n"
"\n"
"To let the BRODALF developers know, post it as a new issue at %ls. The report starts with step-by-step instructions.\n"
"\n"
"Show the report file now?"
msgstr ""
"%ls\n"
"\n"
"Ein Fehlerbericht wurde gespeichert unter:\n"
"%ls\n"
"\n"
"Um die BRODALF-Entwickler zu informieren, stellen Sie ihn als neues Issue unter %ls ein. Der Bericht beginnt mit einer Schritt-für-Schritt-Anleitung.\n"
"\n"
"Berichtsdatei jetzt anzeigen?"

#: gui/main.c:2153
#, c-format
msgid ""
"%ls\n"
"\n"
"The error report could not be saved."
msgstr ""
"%ls\n"
"\n"
"Der Fehlerbericht konnte nicht gespeichert werden."

#: gui/main.c:2188
msgid "BRODALF could not read or write a file or a drive."
msgstr ""
"BRODALF konnte eine Datei oder ein Laufwerk nicht lesen oder beschreiben."

#: gui/main.c:2189
msgid ""
"A drive may be full, unplugged or failing, or another program may have the file open. What was done until then is kept. Check the drive and try again; the app log says more."
msgstr ""
"Ein Laufwerk ist vielleicht voll, nicht angeschlossen oder defekt, oder ein anderes Programm hat die Datei geöffnet. Was bis dahin erledigt war, bleibt erhalten. Prüfen Sie das Laufwerk und versuchen Sie es erneut; das App-Protokoll sagt mehr."

#: gui/main.c:2193
msgid "Something BRODALF needed was not there."
msgstr "Etwas, das BRODALF brauchte, war nicht da."

#: gui/main.c:2194
msgid ""
"A drive may have been unplugged, or a file or folder moved or renamed. Plug the drive in, or check where it is, and try again."
msgstr ""
"Vielleicht wurde ein Laufwerk getrennt oder eine Datei oder ein Ordner verschoben oder umbenannt. Schließen Sie das Laufwerk an oder prüfen Sie, wo es ist, und versuchen Sie es erneut."

#: gui/main.c:2198
msgid "The database is open in another BRODALF window."
msgstr "Die Datenbank ist in einem anderen BRODALF-Fenster geöffnet."

#: gui/main.c:2199
msgid "Use that window, or close it and try again."
msgstr ""
"Verwenden Sie dieses Fenster, oder schließen Sie es und versuchen Sie es erneut."

#: gui/main.c:2203
msgid "Something with that name is already there."
msgstr "Dort gibt es schon etwas mit diesem Namen."

#: gui/main.c:2204
msgid "BRODALF never overwrites anything. Choose another name or place."
msgstr ""
"BRODALF überschreibt nie etwas. Wählen Sie einen anderen Namen oder Ort."

#: gui/main.c:2208
msgid "This is not a BRODALF database, or a newer BRODALF made it."
msgstr ""
"Das ist keine BRODALF-Datenbank, oder ein neueres BRODALF hat sie erstellt."

#: gui/main.c:2209
msgid "Choose a .brodalf file, or update BRODALF to open this one."
msgstr ""
"Wählen Sie eine .brodalf-Datei, oder aktualisieren Sie BRODALF, um diese zu öffnen."

#: gui/main.c:2212
msgid "BRODALF could not do that with what was chosen."
msgstr "BRODALF konnte das mit der getroffenen Auswahl nicht tun."

#: gui/main.c:2213
msgid "Check what you chose and try again."
msgstr "Prüfen Sie Ihre Auswahl und versuchen Sie es erneut."

#: gui/main.c:2216
msgid "The passphrase is needed, or the one given is not right."
msgstr "Die Passphrase wird benötigt, oder die eingegebene ist nicht richtig."

#: gui/main.c:2217
msgid ""
"Enter the passphrase when BRODALF asks for it. The recovery key on your recovery sheet can be used instead."
msgstr ""
"Geben Sie die Passphrase ein, wenn BRODALF danach fragt. Stattdessen kann auch der Wiederherstellungsschlüssel auf Ihrem Wiederherstellungsblatt verwendet werden."

#: gui/main.c:2227
msgid "A drive was unplugged or stopped answering during the job."
msgstr ""
"Während des Vorgangs wurde ein Laufwerk getrennt oder hat nicht mehr geantwortet."

#: gui/main.c:2228
msgid ""
"What was done until then is kept. Plug the drive back in and start the job again: a backup copies only what the drive is still missing."
msgstr ""
"Was bis dahin erledigt war, bleibt erhalten. Schließen Sie das Laufwerk wieder an und starten Sie den Vorgang erneut: Eine Sicherung kopiert nur, was dem Laufwerk noch fehlt."

#: gui/main.c:2241 gui/main.c:3818
msgid "Show the app log"
msgstr "App-Protokoll anzeigen"

#: gui/main.c:2273
#, c-format
msgid "BRODALF crashed (exception 0x%08lX in %ls at +0x%llx)."
msgstr "BRODALF ist abgestürzt (Ausnahme 0x%08lX in %ls bei +0x%llx)."

#: gui/main.c:2320
#, c-format
msgid "%ls   (0 of %lld available, copies on %ls)"
msgstr "%ls   (0 von %lld verfügbar, Kopien auf %ls)"

#: gui/main.c:2322
#, c-format
msgid "%ls   (%lld of %lld available)"
msgstr "%ls   (%lld von %lld verfügbar)"

#: gui/main.c:2324
#, c-format
msgid "%ls   v%d  on %ls"
msgstr "%ls   v%d  auf %ls"

#: gui/main.c:2325
#, c-format
msgid "%ls   on %ls"
msgstr "%ls   auf %ls"

#: gui/main.c:2327
#, c-format
msgid "%ls   v%d"
msgstr "%ls   v%d"

#: gui/main.c:2382
msgid "   ★ starred"
msgstr "   ★ markiert"

#: gui/main.c:2385
msgid "   [encrypted]"
msgstr "   [verschlüsselt]"

#: gui/main.c:2551
msgid "   - not found: unplugged, moved or renamed?"
msgstr "   - nicht gefunden: nicht angeschlossen, verschoben oder umbenannt?"

#: gui/main.c:2552
msgid "   - no longer backed up"
msgstr "   - wird nicht mehr gesichert"

#: gui/main.c:2599
#, c-format
msgid "v%d (current)"
msgstr "v%d (aktuell)"

#: gui/main.c:2599
#, c-format
msgid "v%d"
msgstr "v%d"

#: gui/main.c:2605 gui/main.c:2896
msgid " (encrypted)"
msgstr " (verschlüsselt)"

#: gui/main.c:2612
msgid "Missing from drive"
msgstr "Fehlt auf dem Laufwerk"

#: gui/main.c:2612
msgid "Damaged"
msgstr "Beschädigt"

#: gui/main.c:2613
msgid "Drive marked lost or broken: does not count"
msgstr "Laufwerk als verloren oder defekt markiert: zählt nicht"

#: gui/main.c:2614
msgid "Good, plugged in"
msgstr "Intakt, angeschlossen"

#: gui/main.c:2614
msgid "Good, drive not plugged in"
msgstr "Intakt, Laufwerk nicht angeschlossen"

#: gui/main.c:2643
msgid "Available: a good copy is on a drive that is plugged in."
msgstr ""
"Verfügbar: Eine intakte Kopie liegt auf einem angeschlossenen Laufwerk."

#: gui/main.c:2644
msgid ""
"Changed since the last backup. Only an older version is on a plugged-in drive."
msgstr ""
"Seit der letzten Sicherung geändert. Auf einem angeschlossenen Laufwerk liegt nur eine ältere Version."

#: gui/main.c:2645
msgid "Backed up, but the drive is not plugged in."
msgstr "Gesichert, aber das Laufwerk ist nicht angeschlossen."

#: gui/main.c:2646
msgid "Not backed up yet."
msgstr "Noch nicht gesichert."

#: gui/main.c:2647
msgid ""
"The copy on the plugged-in drive is missing or damaged. Back up again to fix it."
msgstr ""
"Die Kopie auf dem angeschlossenen Laufwerk fehlt oder ist beschädigt. Sichern Sie erneut, um das zu beheben."

#: gui/main.c:2648
msgid "Deleted from your folder. BRODALF still tracks its copies."
msgstr "Aus Ihrem Ordner gelöscht. BRODALF verfolgt die Kopien weiterhin."

#: gui/main.c:2649
msgid "Some files inside are available."
msgstr "Einige Dateien darin sind verfügbar."

#: gui/main.c:2831
msgid ""
"The drive says it is failing. Set up another drive and back up to it; then mark this one broken."
msgstr ""
"Das Laufwerk meldet, dass es ausfällt. Richten Sie ein anderes Laufwerk ein und sichern Sie darauf; markieren Sie dieses dann als defekt."

