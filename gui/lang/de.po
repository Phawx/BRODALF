msgstr " Die nächste Sicherung auf dieses Laufwerk schreibt sie neu."

#: gui/main.c:2413
#, c-format
msgid ""
"Read back: every copy on the drive was read back within the last %d days."
msgstr ""
"Zurücklesen: Alle Kopien auf dem Laufwerk wurden in den letzten %d Tagen bereits zurückgelesen."

#: gui/main.c:2415
#, c-format
msgid "Read back %lld copies: %lld good, %lld damaged, %lld missing.%ls"
