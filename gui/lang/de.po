#: gui/main.c:674
msgid "Primary Database"
msgstr "Hauptdatenbank"

#: gui/main.c:674
msgid "Next backup"
msgstr "Nächste Sicherung"

#: gui/main.c:674
msgid "Local backups"
msgstr "Lokale Sicherungen"

#: gui/main.c:675
msgid "Starred files and extra places"
msgstr "Dateien mit Stern und Zusatzorte"

#: gui/main.c:675 gui/main.c:5717
msgid "Encryption"
msgstr "Verschlüsselung"

#: gui/main.c:675
msgid "Restore"
msgstr "Wiederherstellung"

#: gui/main.c:766 gui/main.c:6517 gui/main.c:6684
