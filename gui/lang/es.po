#: gui/main.c:9008
#, c-format
msgid ""
"%d file or folder matches \"%ls\". Select it to see where its copies are."
msgid_plural ""
"%d files and folders match \"%ls\". Select one to see where its copies are."
msgstr[0] ""
"%d archivo o carpeta coincide con «%ls». Selecciónalo para ver dónde están sus copias."
msgstr[1] ""
"%d archivos y carpetas coinciden con «%ls». Selecciona uno para ver dónde están sus copias."

#: gui/main.c:9277
msgid "under a second"
msgstr "menos de un segundo"

#: gui/main.c:9280
