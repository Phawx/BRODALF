#: gui/main.c:14670
#, c-format
msgid ""
"%lld file in this database has a stored path that would lead outside the folder you restore to. A restore leaves it out and lists it as failed; the log names it."
msgid_plural ""
"%lld files in this database have stored paths that would lead outside the folder you restore to. A restore leaves them out and lists them as failed; the log names the first 20."
msgstr[0] ""
"%lld archivo de esta base de datos tiene una ruta guardada que saldría de la carpeta a la que restauras. Una restauración lo deja fuera y lo cuenta como fallido; el registro lo nombra."
msgstr[1] ""
"%lld archivos de esta base de datos tienen rutas guardadas que saldrían de la carpeta a la que restauras. Una restauración los deja fuera y los cuenta como fallidos; el registro nombra los 20 primeros."

#: gui/main.c:14678
msgid "The database could not be recovered."
msgstr "No se ha podido recuperar la base de datos."

