msgid_plural "%lld bad copies"
msgstr[0] "%lld copia dañada"
msgstr[1] "%lld copias dañadas"

#: gui/main.c:11585
#, c-format
msgid "%lld file to back up"
msgid_plural "%lld files to back up"
msgstr[0] "%lld archivo por copiar"
msgstr[1] "%lld archivos por copiar"

#: gui/main.c:11603
#, c-format
msgid "Kept in: %ls"
msgstr "Guardada en: %ls"

#: gui/main.c:11605
msgid "Marked broken: its copies do not count."
msgstr "Marcada como averiada: sus copias no cuentan."

#: gui/main.c:11606
msgid "Marked lost: its copies do not count."
msgstr "Marcada como perdida: sus copias no cuentan."

#: gui/main.c:11607
#, c-format
msgid "Found at %ls"
msgstr "Encontrado en %ls"

#: gui/main.c:11610
#, c-format
msgid "Not found now. Last found %ls."
msgstr "No se encuentra ahora. Encontrado por última vez: %ls."

#: gui/main.c:11610
#, c-format
msgid "Not plugged in. Last seen %ls."
msgstr "No conectada. Vista por última vez: %ls."

#: gui/main.c:11615
#, c-format
msgid "%ls free of %ls when last seen"
msgstr "%ls libres de %ls la última vez que se vio"

#: gui/main.c:11618
#, c-format
msgid "Copies on it: %ls"
msgstr "Copias en ella: %ls"

#: gui/main.c:11622
#, c-format
msgid "Last backup: %ls. Last check: %ls."
msgstr "Última copia: %ls. Última comprobación: %ls."

#: gui/main.c:11625
msgid ""
"Click to see it on Starred files and extra places. Right-click for what you can do with it."
msgstr ""
"Haz clic para verlo en Destacados y lugares adicionales. Haz clic derecho para ver lo que puedes hacer con él."

#: gui/main.c:11626
msgid ""
"Click to see it on Local backups. Right-click for what you can do with it."
msgstr ""
"Haz clic para verla en Copias locales. Haz clic derecho para ver lo que puedes hacer con ella."

#: gui/main.c:11718
msgid "No database is open"
msgstr "No hay ninguna base de datos abierta"

#: gui/main.c:11720
msgid ""
"Open your database, or create a new one. To start again from a backup drive, use File > Recover the database from a backup drive."
msgstr ""
"Abre tu base de datos o crea una nueva. Para empezar de nuevo desde una unidad de copia, usa Archivo > Recuperar la base de datos de una unidad de copia."

#: gui/main.c:11725
