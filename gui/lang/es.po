msgstr "Marcado como averiado"

#: gui/main.c:13618
msgid "Marked lost"
msgstr "Marcado como perdido"

#: gui/main.c:13632
#, c-format
msgid ""
"Extra places: a second, secondary backup of your %lld starred file (%ls)%ls"
msgid_plural ""
"Extra places: a second, secondary backup of your %lld starred files (%ls)%ls"
msgstr[0] ""
"Lugares adicionales: una segunda copia de seguridad, secundaria, de %lld archivo destacado (%ls)%ls"
msgstr[1] ""
"Lugares adicionales: una segunda copia de seguridad, secundaria, de tus %lld archivos destacados (%ls)%ls"

#: gui/main.c:13634
msgid ". None yet: Add an extra place... sets one up."
msgstr ". Aún no hay ninguno: Añadir un lugar adicional... crea uno."

#: gui/main.c:13715
msgid "not measured yet"
msgstr "aún sin medir"

#: gui/main.c:13754 gui/main.c:13756 gui/brodalf.rc:58
