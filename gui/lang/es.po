#: gui/main.c:676
msgid "Primary Database"
msgstr "Base de datos principal"

#: gui/main.c:676
msgid "Next backup"
msgstr "Próxima copia"

#: gui/main.c:676
msgid "Local backups"
msgstr "Copias locales"

#: gui/main.c:677
msgid "Starred files and extra places"
msgstr "Destacados y lugares adicionales"

#: gui/main.c:677 gui/main.c:5778
msgid "Encryption"
msgstr "Cifrado"

#: gui/main.c:677
msgid "Restore"
msgstr "Restaurar"

#: gui/main.c:768 gui/main.c:6581 gui/main.c:6748
msgid "Drive"
msgstr "Unidad"

#: gui/main.c:768 gui/main.c:5568 gui/main.c:5570 gui/main.c:5766 ...
msgid "State"
msgstr "Estado"

#: gui/main.c:768
msgid "Copies on it"
msgstr "Copias en ella"

#: gui/main.c:769
msgid "Space"
msgstr "Espacio"

#: gui/main.c:769 gui/main.c:5881
msgid "Health"
msgstr "Salud"

#: gui/main.c:769 gui/main.c:17352
msgid "Last checked"
msgstr "Última comprobación"

#: gui/main.c:925
msgid "Ctrl"
msgstr "Ctrl"

#: gui/main.c:925
msgid "Shift"
msgstr "Mayús"

#: gui/main.c:1642
msgid "BRODALF shows the new language the next time you open it."
msgstr "BRODALF mostrará el nuevo idioma la próxima vez que lo abras."

#: gui/main.c:1778 gui/main.c:6810 gui/main.c:12693 gui/main.c:13619 ...
msgid "Yes"
msgstr "Sí"

#: gui/main.c:1778 gui/main.c:6810 gui/main.c:13619 gui/main.c:13620
msgid "No"
msgstr "No"

#: gui/main.c:2236
#, c-format
msgid "Scanning %ls"
msgstr "Analizando %ls"

#: gui/main.c:2238
#, c-format
msgid ""
"Changed although its size and time did not (damage, or a program that keeps its dates?): %ls"
msgstr ""
"Cambió aunque su tamaño y su fecha no (¿un daño, o un programa que conserva sus fechas?): %ls"

#: gui/main.c:2239
#, c-format
msgid "Left alone, because something else is already at %ls"
msgstr "Se omitió, porque ya hay otra cosa en %ls"

#: gui/main.c:2240
#, c-format
msgid ""
"Backup root %ls cannot be reached, so it was skipped. Nothing in it was marked deleted."
msgstr ""
"No se puede acceder a la carpeta de origen %ls, así que se omitió. Nada de su contenido se marcó como eliminado."

#: gui/main.c:2242
#, c-format
msgid "Missing on the drive: %ls"
msgstr "Falta en la unidad: %ls"

#: gui/main.c:2243
#, c-format
msgid "Damaged on the drive: %ls"
msgstr "Dañado en la unidad: %ls"

#: gui/main.c:2244
#, c-format
msgid "In use by another program, so it was skipped: %ls"
msgstr "Lo usa otro programa, así que se omitió: %ls"

#: gui/main.c:2245
#, c-format
msgid "Moved or renamed; its copies are kept: %ls"
msgstr "Movido o renombrado; sus copias se conservan: %ls"

#: gui/main.c:2246
#, c-format
msgid "Skipped a link: %ls"
msgstr "Se omitió un enlace: %ls"

#: gui/main.c:2247
#, c-format
msgid "Online only (not on this PC), so it was skipped: %ls"
msgstr "Solo en línea (no está en este PC), así que se omitió: %ls"

#: gui/main.c:2248
#, c-format
msgid "Online only (not on this PC), so it was not copied: %ls"
msgstr "Solo en línea (no está en este PC), así que no se copió: %ls"

#: gui/main.c:2249
#, c-format
msgid "Changed while it was being copied; scan again: %ls"
msgstr "Cambió mientras se copiaba; vuelve a analizar: %ls"

#: gui/main.c:2251
#, c-format
msgid ""
"Changed again while it was being copied, so another program keeps writing it: %ls"
msgstr ""
"Volvió a cambiar mientras se copiaba, así que otro programa sigue escribiendo en él: %ls"

#: gui/main.c:2253
#, c-format
msgid ""
"%ls is bigger than every backup drive you have: leave it out, or back it up to a bigger drive."
msgstr ""
"%ls es más grande que todas tus unidades de copia: exclúyelo o haz su copia en una unidad más grande."

#: gui/main.c:2255
#, c-format
msgid ""
"The newest copy of the database on the drive (revision %ls) is damaged. The next backup puts a new one there."
msgstr ""
"La copia más reciente de la base de datos en la unidad (revisión %ls) está dañada. La próxima copia pondrá allí una nueva."

#: gui/main.c:2257
#, c-format
msgid ""
"Half-written files from a copy that stopped are on the drive: %ls (%ls bytes). They can be removed."
msgstr ""
"En la unidad hay archivos a medio escribir de una copia que se detuvo: %ls (%ls bytes). Se pueden quitar."

#: gui/main.c:2258
#, c-format
msgid "A link was not followed, so %ls is not backed up: %ls"
msgstr "No se siguió un enlace, así que no se copia %ls: %ls"

#: gui/main.c:2259
#, c-format
msgid "Online only and changed in the cloud, so it is not backed up: %ls"
msgstr "Solo en línea y cambiado en la nube, así que no se copia: %ls"

#: gui/main.c:2261
#, c-format
msgid ""
"Backup root %ls waits for its disk to be plugged in, so it was skipped. Nothing in it was marked deleted."
msgstr ""
"La carpeta de origen %ls espera a que se conecte su disco, así que se omitió. Nada de su contenido se marcó como eliminado."

#: gui/main.c:2263
#, c-format
msgid ""
"Backup root %ls waits until its network share can be reached, so it was skipped. Nothing in it was marked deleted."
msgstr ""
"La carpeta de origen %ls espera a que se pueda acceder a su recurso compartido de red, así que se omitió. Nada de su contenido se marcó como eliminado."

#: gui/main.c:2266
#, c-format
msgid ""
"Backup root %ls is there, but %ls of the %ls files the database knows in it are not, so it was left as it was. Nothing was marked deleted. Is it another folder with the same name?"
msgstr ""
"La carpeta de origen %ls está, pero faltan %ls de los %ls archivos que la base de datos conoce en ella, así que se dejó como estaba. No se marcó nada como eliminado. ¿Es otra carpeta con el mismo nombre?"

#: gui/main.c:2269
#, c-format
msgid ""
"Backup root %ls is now at %ls: BRODALF found its files there (%ls of the %ls it checked, and the contents of the smallest ones)."
msgstr ""
"La carpeta de origen %ls está ahora en %ls: BRODALF encontró allí sus archivos (%ls de los %ls que comprobó, y el contenido de los más pequeños)."

#: gui/main.c:2273
#, c-format
msgid ""
"Backup root %ls is not where it was. %ls holds %ls of the %ls files BRODALF checked, which is not enough to point the backup root there without asking: say where it is now."
msgstr ""
"La carpeta de origen %ls no está donde estaba. %ls contiene %ls de los %ls archivos que BRODALF comprobó, lo que no basta para apuntar la carpeta de origen allí sin preguntar: indica dónde está ahora."

#: gui/main.c:2277
#, c-format
msgid ""
"The folder backup root %ls was in before, %ls, is there again and holds its files, but only %ls is backed up. If %ls is the real one, point the backup root back there."
msgstr ""
"La carpeta en la que estaba antes la carpeta de origen %ls, %ls, ha vuelto y contiene sus archivos, pero solo se hace copia de %ls. Si %ls es la buena, vuelve a apuntar la carpeta de origen allí."

#: gui/main.c:2280
#, c-format
msgid ""
"The scan of %ls was stopped. The %ls files it read are kept, and nothing was marked deleted."
msgstr ""
"Se detuvo el análisis de %ls. Se conservan los %ls archivos que leyó, y no se marcó nada como eliminado."

#: gui/main.c:2283
#, c-format
msgid ""
"Backup root %ls is not where it was, and %ls folders hold its files, so BRODALF picked none: say where it is now. One is %ls (%ls of the %ls files it checked are there)."
msgstr ""
"La carpeta de origen %ls no está donde estaba, y %ls carpetas tienen sus archivos, así que BRODALF no eligió ninguna: indica dónde está ahora. Una es %ls (%ls de los %ls archivos que comprobó están allí)."

#: gui/main.c:2286
#, c-format
msgid ""
"The files of backup root %ls are in %ls (%ls of the %ls BRODALF checked). If that is where it is now, point the backup root there."
msgstr ""
"Los archivos de la carpeta de origen %ls están en %ls (%ls de los %ls que comprobó BRODALF). Si ahora está allí, apunta la carpeta de origen a ese lugar."

#: gui/main.c:2288
#, c-format
msgid "Gone from its folder while backing up; scan again: %ls"
msgstr "Desapareció de su carpeta durante la copia; vuelve a analizar: %ls"

#: gui/main.c:2289
#, c-format
msgid "An older copy is gone from the drive: %ls"
msgstr "Una copia anterior ya no está en la unidad: %ls"

#: gui/main.c:2290
#, c-format
msgid "The copy is there again as it was, so it counts again: %ls"
msgstr "La copia vuelve a estar como estaba, así que cuenta de nuevo: %ls"

#: gui/main.c:2292
#, c-format
msgid ""
"The folder %ls has the name of BRODALF's own folder on the drives, so its new copies go to %ls instead."
msgstr ""
"La carpeta %ls tiene el nombre de la carpeta propia de BRODALF en las unidades, así que sus copias nuevas van a %ls."

#: gui/main.c:2293
#, c-format
msgid "Could not read %ls, so what the database knows about it is kept."
msgstr ""
"No se ha podido leer %ls, así que se conserva lo que la base de datos sabe de él."

#: gui/main.c:2294
#, c-format
msgid "Could not read %ls: %ls"
msgstr "No se ha podido leer %ls: %ls"

#: gui/main.c:2295
#, c-format
msgid "Could not read %ls"
msgstr "No se ha podido leer %ls"

#: gui/main.c:2296
#, c-format
msgid "Could not record the new version of %ls: %ls"
msgstr "No se ha podido registrar la versión nueva de %ls: %ls"

#: gui/main.c:2297
#, c-format
msgid "Could not look at %ls: %ls"
msgstr "No se ha podido examinar %ls: %ls"

#: gui/main.c:2298
#, c-format
msgid "A file BRODALF did not write is at %ls, so it is left alone."
msgstr ""
"En %ls hay un archivo que BRODALF no escribió, así que se deja como está."

#: gui/main.c:2299
#, c-format
msgid "Could not find a free name on the drive for %ls: %ls"
msgstr "No se ha encontrado un nombre libre en la unidad para %ls: %ls"

#: gui/main.c:2300
#, c-format
msgid "Could not copy %ls to the drive: %ls"
msgstr "No se ha podido copiar %ls a la unidad: %ls"

#: gui/main.c:2301
#, c-format
msgid "Could not copy %ls to the drive"
msgstr "No se ha podido copiar %ls a la unidad"

#: gui/main.c:2302
#, c-format
msgid "Could not write the copy of %ls to the drive"
msgstr "No se ha podido escribir la copia de %ls en la unidad"

#: gui/main.c:2304
#, c-format
msgid ""
"A file appeared at %ls while it was being copied, so it was left alone. Back up again."
msgstr ""
"Apareció un archivo en %ls mientras se copiaba, así que se dejó como está. Vuelve a hacer la copia."

#: gui/main.c:2305
#, c-format
msgid "Could not finish writing %ls: %ls"
msgstr "No se ha podido terminar de escribir %ls: %ls"

#: gui/main.c:2306
#, c-format
msgid "Copied %ls, but could not record it: %ls"
msgstr "Se copió %ls, pero no se ha podido registrar: %ls"

#: gui/main.c:2308
#, c-format
msgid ""
"Backing up to %ls drives at once: each file is read once and written to all of them."
msgstr ""
"Copiando en %ls unidades a la vez: cada archivo se lee una vez y se escribe en todas."

#: gui/main.c:2309
#, c-format
msgid "Not backed up: the path stored for %ls could lead outside its folder."
msgstr "Sin copia: la ruta guardada para %ls podría salir de su carpeta."

#: gui/main.c:2311
#, c-format
msgid ""
"%ls is FAT32 and cannot hold files of 4 GB or more; reformat it as exFAT or NTFS. Such files wait for another drive."
msgstr ""
"%ls es FAT32 y no admite archivos de 4 GB o más; formatéala de nuevo como exFAT o NTFS. Esos archivos esperan otra unidad."

#: gui/main.c:2313
msgid ""
"This drive is FAT32 and cannot hold files of 4 GB or more; reformat it as exFAT or NTFS. Such files wait for another drive."
msgstr ""
"Esta unidad es FAT32 y no admite archivos de 4 GB o más; formatéala de nuevo como exFAT o NTFS. Esos archivos esperan otra unidad."

#: gui/main.c:2314
#, c-format
msgid "%ls is full. Files that do not fit wait for another drive."
msgstr "%ls está llena. Los archivos que no caben esperan otra unidad."

#: gui/main.c:2316
#, c-format
msgid ""
"%ls has reached the size you set for it, so starred files over it are not copied there."
msgstr ""
"%ls ha llegado al tamaño que le pusiste, así que los archivos destacados que lo superan no se copian allí."

#: gui/main.c:2317
#, c-format
msgid "%ls stopped answering or was unplugged, so the backup stops."
msgstr "%ls dejó de responder o se desconectó, así que la copia se detiene."

#: gui/main.c:2318
#, c-format
msgid "Could not record the copies found gone: %ls"
msgstr "No se han podido registrar las copias que faltan: %ls"

#: gui/main.c:2319
#, c-format
msgid "Could not record the copies found damaged or missing: %ls"
msgstr "No se han podido registrar las copias dañadas o que faltan: %ls"

#: gui/main.c:2320
#, c-format
msgid "Could not record the copies: %ls"
msgstr "No se han podido registrar las copias: %ls"

#: gui/main.c:2323
#, c-format
msgid ""
"The database could not be saved during the backup (it is saved at the end): %ls"
msgstr ""
"No se ha podido guardar la base de datos durante la copia (se guarda al final): %ls"

#: gui/main.c:2324
#, c-format
msgid "The database could not be copied to the drive: %ls"
msgstr "No se ha podido copiar la base de datos a la unidad: %ls"

#: gui/main.c:2325
#, c-format
msgid "The database could not be copied to %ls: %ls"
msgstr "No se ha podido copiar la base de datos a %ls: %ls"

#: gui/main.c:2327
#, c-format
msgid ""
"The copy on %ls is recorded at a path that could lead outside its folder, so it is not read: %ls"
msgstr ""
"La copia en %ls está registrada en una ruta que podría salir de su carpeta, así que no se lee: %ls"

#: gui/main.c:2328
#, c-format
msgid "Restored %ls from the copy on %ls"
msgstr "Se restauró %ls desde la copia en %ls"

#: gui/main.c:2329
#, c-format
msgid "The copy on %ls is missing: %ls. Trying the next copy."
msgstr "Falta la copia en %ls: %ls. Se prueba la siguiente copia."

#: gui/main.c:2330
#, c-format
msgid "The copy on %ls is missing: %ls"
msgstr "Falta la copia en %ls: %ls"

#: gui/main.c:2331
#, c-format
msgid "The copy on %ls is damaged: %ls. Trying the next copy."
msgstr "La copia en %ls está dañada: %ls. Se prueba la siguiente copia."

#: gui/main.c:2332
#, c-format
msgid "The copy on %ls is damaged: %ls"
msgstr "La copia en %ls está dañada: %ls"

#: gui/main.c:2333
#, c-format
msgid ""
"Could not restore %ls from the copy on %ls: %ls. Trying the next copy."
msgstr ""
"No se ha podido restaurar %ls desde la copia en %ls: %ls. Se prueba la siguiente copia."

#: gui/main.c:2334
#, c-format
msgid "Could not restore %ls from the copy on %ls. Trying the next copy."
msgstr ""
"No se ha podido restaurar %ls desde la copia en %ls. Se prueba la siguiente copia."

#: gui/main.c:2335
#, c-format
msgid "Could not restore %ls from the copy on %ls: %ls"
msgstr "No se ha podido restaurar %ls desde la copia en %ls: %ls"

#: gui/main.c:2336
#, c-format
msgid "Could not restore %ls from the copy on %ls"
msgstr "No se ha podido restaurar %ls desde la copia en %ls"

#: gui/main.c:2337
#, c-format
msgid "Out of memory: could not restore %ls"
msgstr "Sin memoria: no se ha podido restaurar %ls"

#: gui/main.c:2338
#, c-format
msgid "No copy of %ls could be read back right, so it was not restored."
msgstr "Ninguna copia de %ls se pudo leer bien, así que no se restauró."

#: gui/main.c:2340
#, c-format
msgid ""
"Not restored: the path stored for %ls could lead outside the folder you chose."
msgstr ""
"No se restauró: la ruta guardada para %ls podría salir de la carpeta que elegiste."

#: gui/main.c:2342
#, c-format
msgid ""
"%ls: restored an older version; the newer one has no good copy to restore from."
msgstr ""
"%ls: se restauró una versión anterior; la más reciente no tiene una copia buena de la que restaurar."

#: gui/main.c:2343
#, c-format
msgid "%ls: restored an older version; the newer one was never backed up."
msgstr ""
"%ls: se restauró una versión anterior; la más reciente nunca se copió."

#: gui/main.c:2345
#, c-format
msgid ""
"%ls: restored the version from %ls; the newer one has no good copy to restore from."
msgstr ""
"%ls: se restauró la versión del %ls; la más reciente no tiene una copia buena de la que restaurar."

#: gui/main.c:2346
#, c-format
msgid ""
"%ls: restored the version from %ls; the newer one was never backed up."
msgstr "%ls: se restauró la versión del %ls; la más reciente nunca se copió."

#: gui/main.c:2349
#, c-format
msgid "Could not change the folder %ls"
msgstr "No se ha podido cambiar la carpeta %ls"

#: gui/main.c:2350
#, c-format
msgid "Could not compress %ls (another program may have it open)."
msgstr ""
"No se ha podido comprimir %ls (puede que otro programa lo tenga abierto)."

#: gui/main.c:2351
#, c-format
msgid "Could not uncompress %ls (another program may have it open)."
msgstr ""
"No se ha podido descomprimir %ls (puede que otro programa lo tenga abierto)."

#: gui/main.c:2354
#, c-format
msgid ""
"%ls is on a different disk than last time (serial %ls; it was %ls %ls)."
msgstr ""
"%ls está en un disco distinto al de la última vez (número de serie %ls; antes era %ls %ls)."

#: gui/main.c:2355
#, c-format
msgid "Registered the drive %ls again"
msgstr "Se volvió a registrar la unidad %ls"

#: gui/main.c:2356
#, c-format
msgid "Could not check %ls: %ls"
msgstr "No se ha podido comprobar %ls: %ls"

#: gui/main.c:2358
#, c-format
msgid ""
"The backup root name %ls is not a safe folder name, so its files will not be restored."
msgstr ""
"El nombre de la carpeta de origen %ls no es un nombre de carpeta seguro, así que sus archivos no se restaurarán."

#: gui/main.c:2360
#, c-format
msgid ""
"The stored path %ls could lead outside a restore folder, so it will not be restored."
msgstr ""
"La ruta guardada %ls podría salir de una carpeta de restauración, así que no se restaurará."

#: gui/main.c:2362
#, c-format
msgid ""
"A copy on %ls is recorded at %ls, which could lead outside its folder, so it will not be read."
msgstr ""
"Una copia en %ls está registrada en %ls, que podría salir de su carpeta, así que no se leerá."

#: gui/main.c:2364
msgid "Encrypted copies are skipped: enter the passphrase to check them too."
msgstr ""
"Las copias cifradas se omiten: escribe la frase de contraseña para comprobarlas también."

#: gui/main.c:2365
msgid ""
"Files changed since the scan are read again and backed up as they are now."
msgstr ""
"Los archivos que cambiaron desde el análisis se vuelven a leer y se copian tal como están ahora."

#: gui/main.c:2367
msgid ""
"Files that are online only (in the cloud, not on this PC) are skipped, not downloaded."
msgstr ""
"Los archivos que solo están en línea (en la nube, no en este PC) se omiten, no se descargan."

#: gui/main.c:2368
msgid "The drive is full. Files that do not fit wait for another drive."
msgstr "La unidad está llena. Los archivos que no caben esperan otra unidad."

#: gui/main.c:2369
msgid "The drive stopped answering or was unplugged, so the backup stops."
msgstr ""
"La unidad dejó de responder o se desconectó, así que la copia se detiene."

#: gui/main.c:2371
msgid ""
"The drive stopped answering or was unplugged. Nothing on it was marked missing or damaged."
msgstr ""
"La unidad dejó de responder o se desconectó. No se marcó nada en ella como perdido o dañado."

#: gui/main.c:2374
#, c-format
msgid ""
"Backup root %ls is left out of this backup: the last scan did not find %ls of its files in its folder. Say where it is now, or scan again."
msgstr ""
"La carpeta de origen %ls queda fuera de esta copia: el último análisis no encontró %ls de sus archivos en su carpeta. Indica dónde está ahora o vuelve a analizar."

#: gui/main.c:2377
#, c-format
msgid ""
"Backup root %ls is left out of this backup: its folder cannot be found."
msgstr ""
"La carpeta de origen %ls queda fuera de esta copia: no se encuentra su carpeta."

#: gui/main.c:2379
#, c-format
msgid ""
"Backup root %ls is left out of this backup: it waits for its disk to be plugged in."
msgstr ""
"La carpeta de origen %ls queda fuera de esta copia: espera a que se conecte su disco."

#: gui/main.c:2381
#, c-format
msgid ""
"Backup root %ls is left out of this backup: the last scan did not find it, so scan it first."
msgstr ""
"La carpeta de origen %ls queda fuera de esta copia: el último análisis no la encontró, así que analízala primero."

#: gui/main.c:2388
#, c-format
msgid "could not look at %ls"
msgstr "no se ha podido examinar %ls"

#: gui/main.c:2389
#, c-format
msgid "could not create the folder for %ls"
msgstr "no se ha podido crear la carpeta de %ls"

#: gui/main.c:2390
#, c-format
msgid "could not write %ls"
msgstr "no se ha podido escribir %ls"

#: gui/main.c:2391
#, c-format
msgid "could not move %ls to %ls"
msgstr "no se ha podido mover %ls a %ls"

#: gui/main.c:2393
#, c-format
msgid ""
"the name \"%ls\" in this folder is not valid Unicode, so it cannot be read. Rename it to back it up"
msgstr ""
"el nombre \"%ls\" de esta carpeta no es Unicode válido, así que no se puede leer. Cámbiale el nombre para hacer copia de él"

#: gui/main.c:2395
#, c-format
msgid ""
"these names in this folder are not valid Unicode, so they cannot be read: %ls (%ls in all). Rename them to back them up"
msgstr ""
