#: gui/main.c:699
msgid "Primary Database"
msgstr "Base de datos principal"

#: gui/main.c:699
msgid "Next backup"
msgstr "Próxima copia"

#: gui/main.c:699
msgid "Local backups"
msgstr "Copias locales"

#: gui/main.c:700
msgid "Starred files and extra places"
msgstr "Destacados y lugares adicionales"

#: gui/main.c:700 gui/main.c:5943
msgid "Encryption"
msgstr "Cifrado"

#: gui/main.c:700
msgid "Restore"
msgstr "Restaurar"

#: gui/main.c:791 gui/main.c:6759 gui/main.c:6928
