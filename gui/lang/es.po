#: gui/main.c:8145
#, c-format
msgid ""
"\r\n"
"Warning: %lld of the %lld files whose copies on this drive were up to date have changed at once. That can mean ransomware. Look at Files changed on it... before backing up."
msgstr ""
"\r\n"
